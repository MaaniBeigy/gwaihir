# --------------------------------------------------------------------------------------------------
# coach-api environment template.
# Copy to `.env` for local docker-compose dev (`docker compose --env-file .env up`).
# Production secrets go into the orchestrator's secret store, not into a checked-in file.
# --------------------------------------------------------------------------------------------------

# ---- Local dev / production toggle ----
# false in dev (skips X-Client-CN / X-Coach-Internal-Token checks);
# true in production (enforces them — all traffic must come via the nginx mTLS terminator).
COACH_REQUIRE_MTLS=false

# Shared secret for all coach internal traffic (constant-time compared on every authenticated route
# and echoed on outbound webhook posts). Generate with: openssl rand -hex 32
COACH_INTERNAL_TOKEN=dev-only-change-me

# Expected client CN that nginx will set on X-Client-CN. Production must be `gamebus-api-v2`.
COACH_EXPECTED_PEER_CN=gamebus-api-v2

# ---- LLM / OpenRouter ----
# OpenRouter key for the supervisor / interviewer / standardizer / scheduler / controller agents.
# Each /chat request can override this with its `llmKey` body field.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Per-agent model overrides (all optional, each agent has a sensible default).
INTERVIEWER_MODEL=inclusionai/ling-2.6-1t:free
STANDARDIZER_MODEL=inclusionai/ling-2.6-1t:free
SCHEDULER_MODEL=
CONTROLLER_MODEL=inclusionai/ling-2.6-1t:free

# ---- Scheduling defaults ----
# Default scheduling horizon when a /chat body does not override it.
SCHEDULING_PERIOD_WEEKS=1
COACH_DEFAULT_TIMEZONE=Europe/Amsterdam

# Max scheduler-controller rounds before the latest plan is accepted as is.
COACH_MAX_SCHEDULE_ITERATIONS=3

# ---- Chroma ----
# Local dev uses an embedded persistent client at CHROMA_PATH.
# Production sets CHROMA_HOST/CHROMA_PORT to point at the chroma-db container.
CHROMA_PATH=/app/chroma_db
CHROMA_HOST=
CHROMA_PORT=8000

# How many days of `(playerId, campaignId)` vectors to keep before the periodic flush deletes them.
COACH_MEMORY_RETENTION_DAYS=7

# ---- Embeddings ----
# Cache directory for the BGE model weights. Mount the `coach-models` volume here so the
# model survives container restarts.
HF_HOME=/models

# ---- Webhook (production only) ----
# coach-api -> gateway progress webhook. Empty in dev; set in production.
COACH_WEBHOOK_URL=https://gateway.example.com:8443/coach/internal/progress
COACH_WEBHOOK_CLIENT_CERT=/etc/coach/client.crt
COACH_WEBHOOK_CLIENT_KEY=/etc/coach/client.key
COACH_WEBHOOK_SERVER_CA=/etc/coach/gateway-server-ca.pem
